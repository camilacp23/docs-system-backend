# Copy to .env and replace every CHANGE_ME. Never commit .env (NFR-06).

# --- Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set only behind a reverse proxy (express "trust proxy"); false in local development
TRUST_PROXY=false

# --- Prisma CLI (migrations only): OWNER role
# DATABASE_URL is read ONLY by the Prisma CLI (`prisma migrate deploy`, `npm run db:drift`) and by `prisma generate`.
# The API never reads it: at runtime it connects with APP_DATABASE_URL (docs_app).
DATABASE_URL="postgresql://docs_owner:CHANGE_ME@localhost:5432/docs_system"
# Development only: shadow database for `npm run db:drift` (docs_owner needs CREATEDB)
SHADOW_DATABASE_URL="postgresql://docs_owner:CHANGE_ME@localhost:5432/docs_shadow"

# --- API at runtime: APPLICATION role (DML only)
APP_DATABASE_URL="postgresql://docs_app:CHANGE_ME@localhost:5432/docs_system"

# --- Security (SDD Section 11)
# kid:base64 of 32+ random bytes (openssl rand -base64 32). Several comma-separated; the first signs.
JWT_KEYS="k2026a:CHANGE_ME"
JWT_ACCESS_TTL_SECONDS=28800
SESSION_MAX_SECONDS=43200
BCRYPT_COST=12
# Only Origin accepted by CORS and by the cookie endpoints (local dev: Vite dev server)
FRONTEND_ORIGIN="http://localhost:5173"
# D-60: refresh/logout rate limit
RATE_LIMIT_SESSION_MAX=30
RATE_LIMIT_SESSION_WINDOW_MINUTES=15

# --- Reserved account "Integración Jira" (D-51, CP-06). Required: the API refuses to start without it.
INTEGRATION_USER_EMAIL="integracion.jira@system.local"

# --- Seed (npm run db:seed). Remove SEED_ADMIN_PASSWORD from .env after the first seed.
SEED_ADMIN_NAME="Camila Castillo Porras"
SEED_ADMIN_EMAIL="camilacastilloporras23@gmail.com"
# 12-128 characters with letters and digits (NFR-02)
SEED_ADMIN_PASSWORD="CHANGE_ME"

# --- Jira Cloud (technical account of the department). Optional: without them the API starts and Jira features
# report unavailable (D-89). JIRA_BASE_URL must be https (http only for the local Jira simulator, never in production).
# Never put real values in this file.
JIRA_BASE_URL="https://<site>.atlassian.net"
JIRA_EMAIL="<technical account email>"
JIRA_API_TOKEN="CHANGE_ME"
JIRA_PROJECT_KEY="TECHEA"
JIRA_ISSUETYPE_EPIC_ID=""
JIRA_ISSUETYPE_STORY_ID=""
JIRA_ISSUETYPE_SUBTASK_ID=""
JIRA_WEBHOOK_SECRET="CHANGE_ME"

# --- Report worker (D-44, D-118, D-119). Values are not secret; these are the defaults.
# Generates the PDF and Excel reports inside the API process. Set to false to run without it.
REPORT_WORKER_ENABLED=true
# How often an idle worker looks for a PENDING report (milliseconds, 100-60000)
REPORT_WORKER_POLL_MS=5000
# Longest time to generate one report (seconds, 5-900); a slower one is FAILED
REPORT_MAX_SECONDS=60
# Largest report file (bytes, 1048576-209715200); a bigger one is FAILED
REPORT_MAX_BYTES=33554432
# Memory of the thread that writes the file (MB, 64-4096); a report that needs more is FAILED and the API goes on
REPORT_MAX_MEMORY_MB=512
# Most rows of all the parts of a report together (100-1000000); more is FAILED
REPORT_MAX_ROWS=50000
# Time given to the report being generated when the server stops (milliseconds, 0-9000; the server exits at 10 s)
REPORT_SHUTDOWN_GRACE_MS=8000

# --- Production (examples; keep them commented here and set the real ones in the environment of the service)
# Example values only: nothing below is a secret. Set the same names with the values your service needs.
#   NODE_ENV=production
#   PORT=3000
#   LOG_LEVEL=info
# TRUST_PROXY: how many reverse proxies stand in front of the API (1 = the platform's proxy). NEVER use true: Express would
# trust any X-Forwarded-For header, so a client could pick its own IP and avoid the rate limits (D-60, login lockout).
# Without a proxy leave it false.
#   TRUST_PROXY=1
# Report worker (the defaults are the ones above; REPORT_MAX_MEMORY_MB is lowered for a small instance)
#   REPORT_WORKER_ENABLED=true
#   REPORT_WORKER_POLL_MS=5000
#   REPORT_MAX_SECONDS=60
#   REPORT_MAX_BYTES=33554432
#   REPORT_MAX_MEMORY_MB=192
#   REPORT_MAX_ROWS=50000
#   REPORT_SHUTDOWN_GRACE_MS=8000
