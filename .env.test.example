# Optional. Copy to .env.test (git-ignored) only to override .env for the test tooling. Placeholders only (NFR-06).
# The tests use DATABASE_URL (docs_owner) and APP_DATABASE_URL (docs_app) from .env, changing only the database
# name (docs_test_template, docs_test_<random>). They never touch docs_system.

# --- Credentials: choose ONE of the two options
# Option A (local, Windows/Linux): leave the passwords out of the URLs and keep them in pgpass
#   Windows: %APPDATA%\postgresql\pgpass.conf    Linux/macOS: ~/.pgpass (chmod 600)
#   lines:   localhost:5432:*:postgres:<password>   localhost:5432:*:docs_owner:<password>   localhost:5432:*:docs_app:<password>
# Option B (CI): environment variables, only read (never printed). One per role for scripts/test-legacy.sh:
#   PGPASSWORD_OWNER=CHANGE_ME
#   PGPASSWORD_APP=CHANGE_ME
#   PGPASSWORD_SUPERUSER=CHANGE_ME
# (a single PGPASSWORD is also accepted by psql and by the pg driver)

# --- Test database helper (tests/helpers/testDb.ts)
# Maintenance database where docs_owner runs CREATE/DROP DATABASE (docs_owner needs CREATEDB). Default: postgres
# TEST_DB_MAINTENANCE_DB=postgres
# DATABASE_URL="postgresql://docs_owner@localhost:5432/postgres"
# APP_DATABASE_URL="postgresql://docs_app@localhost:5432/postgres"

# --- Phase 2 regression suite (scripts/test-legacy.sh / npm run test:legacy)
# Database copied for every test (default docs_system; nobody may be connected to it while it is copied)
# LEGACY_SOURCE_DB=docs_system
# LEGACY_MAINTENANCE_DB=postgres
# PGHOST=localhost
# PGPORT=5432
# LEGACY_OWNER_USER=docs_owner
# LEGACY_APP_USER=docs_app
# LEGACY_SUPERUSER=postgres
